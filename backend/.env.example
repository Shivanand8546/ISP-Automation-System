NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://isp:isp@localhost:5432/ispflow

# One-time first administrator provisioning; set locally, never commit credentials
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
PAYMENT_PROVIDER=MOCK
PAYMENT_PENDING_EXPIRY_MINUTES=30
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
UPI_ID=yourupi@upi
UPI_PAYEE_NAME=ISPFlow
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@ispflow.local
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
SESSION_EXPIRY_DAYS=7
IDEMPOTENCY_KEY_TTL_HOURS=24
PROMETHEUS_PORT=9090
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
MONITOR_INTERVAL_MS=30000
DEVICE_OFFLINE_THRESHOLD_MS=60000
SLA_LOW=72
SLA_MEDIUM=24
SLA_HIGH=8
SLA_CRITICAL=2
